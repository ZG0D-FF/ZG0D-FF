{
  "buildCommand": "cd imposter-game && npm install && npx cross-env NODE_OPTIONS='--trace-deprecation' npm run build",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/assets/videos/:path*",
      "destination": "https://raw.githubusercontent.com/ZG0D-FF/ZG0D-FF/main/assets/videos/:path*"
    },
    {
      "source": "/audio/:path*",
      "destination": "https://raw.githubusercontent.com/ZG0D-FF/ZG0D-FF/main/audio/:path*"
    },
    {
      "source": "/RAIN/:file(.+\\.(?:mp4|mp3|wav))",
      "destination": "https://raw.githubusercontent.com/ZG0D-FF/ZG0D-FF/main/RAIN/:file"
    },
    {
      "source": "/Journal/:file(.+\\.(?:mp4|mp3|wav))",
      "destination": "https://raw.githubusercontent.com/ZG0D-FF/ZG0D-FF/main/Journal/:file"
    },
    {
      "source": "/VLSI_Design/:file(.+\\.pdf)",
      "destination": "https://raw.githubusercontent.com/ZG0D-FF/ZG0D-FF/main/VLSI_Design/:file"
    },
    {
      "source": "/AIT/:file(.+\\.pdf)",
      "destination": "https://raw.githubusercontent.com/ZG0D-FF/ZG0D-FF/main/AIT/:file"
    },
    {
      "source": "/ESEP/:file(.+\\.pdf)",
      "destination": "https://raw.githubusercontent.com/ZG0D-FF/ZG0D-FF/main/ESEP/:file"
    },
    {
      "source": "/ITC/:file(.+\\.(?:pdf|pptx|ppt))",
      "destination": "https://raw.githubusercontent.com/ZG0D-FF/ZG0D-FF/main/ITC/:file"
    },
    {
      "source": "/aidata/:file(.+\\.pdf)",
      "destination": "https://raw.githubusercontent.com/ZG0D-FF/ZG0D-FF/main/aidata/:file"
    },
    {
      "source": "/AIT/ME%20AND%20DADADIDI/:path*",
      "destination": "https://raw.githubusercontent.com/ZG0D-FF/ZG0D-FF/main/AIT/ME%20AND%20DADADIDI/:path*"
    }
  ],
  "crons": [{
    "path": "/api/jarvis-cron",
    "schedule": "30 0 * * *"
  }]
}
